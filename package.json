{
  "name": "pos-supermarket",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint src --max-warnings=0",
    "lint:fix": "eslint src --fix",
    "format": "prettier \"src/**/*.{ts,tsx,css}\" \"*.{json,md,html}\" \"eslint.config.js\" \"vite.config.ts\" --write",
    "format:check": "prettier \"src/**/*.{ts,tsx,css}\" \"*.{json,md,html}\" \"eslint.config.js\" \"vite.config.ts\" --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky || true",
    "validate": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "@zxing/browser": "^0.2.0",
    "date-fns": "^4.1.0",
    "primeflex": "^3.3.1",
    "primeicons": "^7.0.0",
    "primereact": "^10.8.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uuid": "^10.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "prettier": "^3.8.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.59.3",
    "vite": "^6.0.3",
    "vitest": "^4.1.6"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,html,json,md}": [
      "prettier --write"
    ]
  }
}
